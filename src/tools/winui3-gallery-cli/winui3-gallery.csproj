<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>winui3-gallery</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Data\scenario-index.json" LogicalName="scenario-index.json" />
    <EmbeddedResource Include="Data\core-patterns.json" LogicalName="core-patterns.json" />
    <EmbeddedResource Include="Data\enrichment-tags.json" LogicalName="enrichment-tags.json" />
  </ItemGroup>
</Project>
