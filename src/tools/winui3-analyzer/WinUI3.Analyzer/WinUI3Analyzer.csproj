<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <RootNamespace>WinUI3.Analyzer</RootNamespace>
    <AssemblyName>WinUI3.Analyzer</AssemblyName>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>WinUI3.Analyzer</PackageId>
    <PackageVersion>0.1.0</PackageVersion>
    <Description>Roslyn analyzers for WinUI 3 apps — catches common runtime pitfalls at build time.</Description>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Pack the analyzer DLL and targets into the correct NuGet folders -->
  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="WinUI3.Analyzer.targets" Pack="true" PackagePath="buildTransitive" Visible="false" />
    <None Include="WinUI3.Analyzer.targets" Pack="true" PackagePath="build" Visible="false" />
  </ItemGroup>

</Project>
