<?xml version="1.0" encoding="utf-8"?>
<!--
  nuget.config used inside the Azure DevOps compliance pipeline. The 1ES
  Azure-Pipelines-1ESPT-ExDShared pool blocks the public api.nuget.org, so
  we restore through Microsoft's internal upstream mirror feed instead.

  This file is swapped into the repo root as `nuget.config` by ci.yml before
  the build step runs. It is intentionally NOT named `nuget.config` so it
  doesn't affect local developer builds (which go straight to api.nuget.org).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="pde-oss_Internal" value="https://pkgs.dev.azure.com/microsoft/pde-oss/_packaging/pde-oss_Internal/nuget/v3/index.json" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
